## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Build results
[Dd]ebug/
[Rr]elease/
x64/
x86/
build/
out/
bin/
obj/
TestResults/
[Ll]og/
*.log

# Uncomment if you have tasks that create the wwwroot/dist or publish folders
#wwwroot/dist/
#publish/

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/
*.db-shm
*.db-wal

# .NET Core Runtime
*.deps.json
*.runtimeconfig.dev.json
*.runtimeconfig.json

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# VS Code settings
.vscode/
.history/

# Rider settings
.idea/
*.sln.iml
CFour.sln.DotSettings.user

# Tye (for microservices orchestration)
.tye/

# Docker
*.pid
*.tar
*.img
docker-compose.override.yml
docker-compose.*.yml

# NPM & frontend
node_modules/
bower_components/
jspm_packages/
package-lock.json
yarn.lock

# libman (Library Manager)
wwwroot/lib/

# Environment files
.env
.env.*.local
secrets.json

# Others
*.sqlite
*.sqlite3
*.bak
*.mdf
*.ldf

# Resharper
_ReSharper*/
*.DotSettings.user

# Visual Studio cache
.vs/

# LocalDB
*.mdf
*.ldf

# IIS Express
.vsconfig
.vscode
/.vs
/.vs/
*.iisexpress

# NuGet
*.nupkg
packages/
*.snupkg

# Publish output
publish/
*.publish.xml

# Logs
*.log
logs/
